// Minimal-but-growable YAML reader.
//
// Block style only for now (mappings, sequences, plain/quoted scalars,
// comments). Flow style ([a, b], {a: b}), anchors/aliases, tags, block
// scalars (| and >) and multi-document streams are not implemented yet --
// see the NodeKind/ScalarStyle enums below, which already reserve room for
// them so later work doesn't need to reshape the value model.
//
// Values are modeled the same way std/json models them: a plain (payload-
// free) Kind enum plus a class holding every possible field, rather than an
// enum whose variants carry payloads. That's not a style preference -- zapc
// (v0.4.1) cannot construct or reference a payload-free variant of an enum
// that also has payload-carrying variants (see COMPILER_BUGS.md, bug #1).
// The original draft of this file used an enum shaped exactly that way
// (`Num(Float64) | Integer(Int64) | Text(String) | Collection(Collection)`
// plus a bare `Null`-style case) and it failed to compile for that reason.

import "std/string" as string;
import "std/collection" as collection;
import "std/convert" as convert;

pub enum NodeKind { Null, Boolean, Integer, Float, String, Sequence, Mapping }
pub enum ScalarStyle { Plain, SingleQuoted, DoubleQuoted, Literal, Folded }

pub enum ErrorKind {
    UnexpectedEnd,
    InvalidIndent,
    TrailingContent,
    MissingColon,
    DuplicateKey,
    InvalidScalar,
    TypeMismatch,
    IndexOutOfBounds,
    MissingKey,
}

@error
pub struct Error { kind: ErrorKind, line: Int, message: String }

fun errorAt(kind: ErrorKind, line: Int, message: String) Error {
    return Error { kind: kind, line: line, message: message };
}

fun accessError(kind: ErrorKind, message: String) Error {
    return errorAt(kind, -1, message);
}

fun kindName(kind: NodeKind) String {
    if kind == NodeKind.Null { return "null"; }
    if kind == NodeKind.Boolean { return "boolean"; }
    if kind == NodeKind.Integer { return "integer"; }
    if kind == NodeKind.Float { return "float"; }
    if kind == NodeKind.String { return "string"; }
    if kind == NodeKind.Sequence { return "sequence"; }
    return "mapping";
}

fun typeError(expected: String, actual: NodeKind) Error {
    return accessError(ErrorKind.TypeMismatch, "Expected " + expected + ", got " + kindName(actual));
}

fun isDigitChar(c: Char) Bool {
    return c >= '0' && c <= '9';
}

fun isSpaceChar(c: Char) Bool {
    return c == ' ' || c == '\t';
}

fun isIntegerText(text: String) Bool {
    var n: Int = string.len(text);
    if n == 0 { return false; }
    var i: Int = 0;
    var c0: Char = string.at(text, 0);
    if c0 == '-' || c0 == '+' {
        i = 1;
        if i >= n { return false; }
    }
    while i < n {
        if !isDigitChar(string.at(text, i)) { return false; }
        i = i + 1;
    }
    return true;
}

fun isFloatText(text: String) Bool {
    var n: Int = string.len(text);
    if n == 0 { return false; }
    var i: Int = 0;
    var c0: Char = string.at(text, 0);
    if c0 == '-' || c0 == '+' { i = 1; }
    var sawDigit: Bool = false;
    var sawDot: Bool = false;
    var sawExp: Bool = false;
    while i < n {
        var c: Char = string.at(text, i);
        if isDigitChar(c) { sawDigit = true; i = i + 1; }
        else if c == '.' && !sawDot && !sawExp { sawDot = true; i = i + 1; }
        else if (c == 'e' || c == 'E') && !sawExp && sawDigit {
            sawExp = true;
            i = i + 1;
            if i < n && (string.at(text, i) == '+' || string.at(text, i) == '-') { i = i + 1; }
        } else { return false; }
    }
    return sawDigit && (sawDot || sawExp);
}

fun digitValue(c: Char) Int {
    return convert.toInt(c) - convert.toInt('0');
}

pub class Sequence {
    priv values: collection.List<Node>;

    fun init() { self.values = new collection.List<Node>(); }

    pub fun push(value: Node) { self.values.push(value); }
    pub fun len() Int { return self.values.len(); }

    pub fun at(index: Int) Node!Error {
        if index < 0 || index >= self.values.len() {
            fail accessError(ErrorKind.IndexOutOfBounds, "YAML sequence index is out of bounds");
        }
        return self.values.at(index);
    }

    pub fun getString(index: Int) String!Error { var value: Node = self.at(index)?; return value.asString()?; }
    pub fun getInt(index: Int) Int!Error { var value: Node = self.at(index)?; return value.asInt()?; }
    pub fun getBool(index: Int) Bool!Error { var value: Node = self.at(index)?; return value.asBool()?; }
}

pub class Mapping {
    priv values: collection.HashMap<Node>;
    priv keys: collection.List<String>;

    fun init() {
        self.values = new collection.HashMap<Node>();
        self.keys = new collection.List<String>();
    }

    // Deliberately infallible (unlike Mapping.get/getMapping/etc below): a
    // bare `obj.method(...)?;` statement inside a loop inside a method that
    // itself recurses hangs zapc v0.4.1 forever instead of compiling or
    // erroring -- see COMPILER_BUGS.md, bug #2. Parser.mapping() below does
    // its own `has()` check and fails *itself* before calling put(), so put()
    // never needs to be failable.
    pub fun put(key: String, value: Node) {
        self.values.put(key, value);
        self.keys.push(key);
    }

    pub fun has(key: String) Bool { return self.values.contains(key); }
    pub fun len() Int { return self.keys.len(); }

    pub fun keyAt(index: Int) String!Error {
        if index < 0 || index >= self.keys.len() {
            fail accessError(ErrorKind.IndexOutOfBounds, "YAML mapping key index is out of bounds");
        }
        return self.keys.at(index);
    }

    pub fun get(key: String) Node!Error {
        if !self.values.contains(key) {
            fail accessError(ErrorKind.MissingKey, "Missing YAML mapping key: " + key);
        }
        return self.values.get(key);
    }

    pub fun getString(key: String) String!Error { var value: Node = self.get(key)?; return value.asString()?; }
    pub fun getInt(key: String) Int!Error { var value: Node = self.get(key)?; return value.asInt()?; }
    pub fun getBool(key: String) Bool!Error { var value: Node = self.get(key)?; return value.asBool()?; }
    pub fun getMapping(key: String) Mapping!Error { var value: Node = self.get(key)?; return value.asMapping()?; }
    pub fun getSequence(key: String) Sequence!Error { var value: Node = self.get(key)?; return value.asSequence()?; }
}

pub class Node {
    priv nodeKind: NodeKind;
    priv scalar: String;
    priv style: ScalarStyle;
    priv sequence: Sequence;
    priv mapping: Mapping;

    fun init(kind: NodeKind, scalar: String, style: ScalarStyle, sequence: Sequence, mapping: Mapping) {
        self.nodeKind = kind;
        self.scalar = scalar;
        self.style = style;
        self.sequence = sequence;
        self.mapping = mapping;
    }

    pub static fun nullValue() Node { return new Node(NodeKind.Null, "", ScalarStyle.Plain, null, null); }
    pub static fun boolean(value: Bool) Node {
        var text: String = value ? "true" : "false";
        return new Node(NodeKind.Boolean, text, ScalarStyle.Plain, null, null);
    }
    pub static fun integerText(text: String) Node { return new Node(NodeKind.Integer, text, ScalarStyle.Plain, null, null); }
    pub static fun floatText(text: String) Node { return new Node(NodeKind.Float, text, ScalarStyle.Plain, null, null); }
    pub static fun string(text: String, style: ScalarStyle) Node { return new Node(NodeKind.String, text, style, null, null); }
    pub static fun sequence(value: Sequence) Node { return new Node(NodeKind.Sequence, "", ScalarStyle.Plain, value, null); }
    pub static fun mapping(value: Mapping) Node { return new Node(NodeKind.Mapping, "", ScalarStyle.Plain, null, value); }

    pub fun kind() NodeKind { return self.nodeKind; }
    pub fun isNull() Bool { return self.nodeKind == NodeKind.Null; }
    pub fun isBoolean() Bool { return self.nodeKind == NodeKind.Boolean; }
    pub fun isInteger() Bool { return self.nodeKind == NodeKind.Integer; }
    pub fun isFloat() Bool { return self.nodeKind == NodeKind.Float; }
    pub fun isString() Bool { return self.nodeKind == NodeKind.String; }
    pub fun isSequence() Bool { return self.nodeKind == NodeKind.Sequence; }
    pub fun isMapping() Bool { return self.nodeKind == NodeKind.Mapping; }

    // Raw, unchecked accessors: convenient when the caller already knows the
    // shape of the document (e.g. right after parsing a known config).
    pub fun items() Sequence { return self.sequence; }
    pub fun entries() Mapping { return self.mapping; }

    pub fun asString() String!Error {
        if !self.isString() { fail typeError("string", self.nodeKind); }
        return self.scalar;
    }

    pub fun asBool() Bool!Error {
        if !self.isBoolean() { fail typeError("boolean", self.nodeKind); }
        return string.eq(self.scalar, "true");
    }

    pub fun asInt() Int!Error {
        if !self.isInteger() { fail typeError("integer", self.nodeKind); }
        var raw: String = self.scalar;
        var n: Int = string.len(raw);
        var negative: Bool = string.at(raw, 0) == '-';
        var i: Int = (string.at(raw, 0) == '-' || string.at(raw, 0) == '+') ? 1 : 0;
        var result: Int = 0;
        while i < n {
            var digit: Int = digitValue(string.at(raw, i));
            if negative { result = result * 10 - digit; } else { result = result * 10 + digit; }
            i = i + 1;
        }
        return result;
    }

    pub fun asFloat64() Float64!Error {
        if !self.isFloat() && !self.isInteger() { fail typeError("float", self.nodeKind); }
        var raw: String = self.scalar;
        var n: Int = string.len(raw);
        var i: Int = 0;
        var negative: Bool = false;
        if string.at(raw, i) == '-' { negative = true; i = i + 1; }
        else if string.at(raw, i) == '+' { i = i + 1; }

        var whole: Float64 = 0.0;
        while i < n && isDigitChar(string.at(raw, i)) {
            whole = whole * 10.0 + convert.toFloat64(digitValue(string.at(raw, i)));
            i = i + 1;
        }

        var fraction: Float64 = 0.0;
        var scale: Float64 = 1.0;
        if i < n && string.at(raw, i) == '.' {
            i = i + 1;
            while i < n && isDigitChar(string.at(raw, i)) {
                fraction = fraction * 10.0 + convert.toFloat64(digitValue(string.at(raw, i)));
                scale = scale * 10.0;
                i = i + 1;
            }
        }

        var value: Float64 = whole + fraction / scale;

        if i < n && (string.at(raw, i) == 'e' || string.at(raw, i) == 'E') {
            i = i + 1;
            var expNegative: Bool = false;
            if i < n && (string.at(raw, i) == '+' || string.at(raw, i) == '-') {
                expNegative = string.at(raw, i) == '-';
                i = i + 1;
            }
            var exponent: Int = 0;
            while i < n && isDigitChar(string.at(raw, i)) {
                exponent = exponent * 10 + digitValue(string.at(raw, i));
                i = i + 1;
            }
            var step: Int = 0;
            while step < exponent {
                if expNegative { value = value / 10.0; } else { value = value * 10.0; }
                step = step + 1;
            }
        }

        if negative { value = -value; }
        return value;
    }

    pub fun asSequence() Sequence!Error {
        if !self.isSequence() { fail typeError("sequence", self.nodeKind); }
        return self.sequence;
    }

    pub fun asMapping() Mapping!Error {
        if !self.isMapping() { fail typeError("mapping", self.nodeKind); }
        return self.mapping;
    }
}

pub class Document {
    priv root: Node;
    fun init(root: Node) { self.root = root; }
    pub fun getRoot() Node { return self.root; }
}

// Scanner output is deliberately separate from parsing: block structure
// (mappings/sequences/scalars) is decided line-by-line, so this is the
// natural place to grow flow tokens, tags, anchors/aliases, directives and
// block-scalar (| and >) headers later without touching the parser's
// recursion.
class LineToken {
    priv indent: Int;
    priv text: String;
    priv line: Int;

    fun init(indent: Int, text: String, line: Int) {
        self.indent = indent;
        self.text = text;
        self.line = line;
    }

    pub fun getIndent() Int { return self.indent; }
    pub fun getText() String { return self.text; }
    pub fun getLine() Int { return self.line; }
}

class Scanner {
    priv source: StringView;
    fun init(source: StringView) { self.source = source; }

    pub fun scan() collection.List<LineToken> {
        let out = new collection.List<LineToken>();
        var start: Int = 0;
        var line: Int = 1;
        var i: Int = 0;
        while i <= len(self.source) {
            if i == len(self.source) || self.source[i] == '\n' {
                var end: Int = i;
                if end > start && self.source[end - 1] == '\r' { end = end - 1; }

                var indent: Int = 0;
                while start + indent < end && self.source[start + indent] == ' ' { indent = indent + 1; }

                let raw = string.owned(slice(self.source, start + indent, end - start - indent));
                let text = string.trim(stripComment(raw));
                if string.stringLen(text) > 0 {
                    out.push(new LineToken(indent, text, line));
                }

                start = i + 1;
                line = line + 1;
            }
            i = i + 1;
        }
        return out;
    }
}

class Parser {
    priv lines: collection.List<LineToken>;
    priv index: Int;

    fun init(lines: collection.List<LineToken>) {
        self.lines = lines;
        self.index = 0;
    }

    pub fun parse() Document!Error {
        if self.lines.isEmpty() { return new Document(Node.nullValue()); }

        // Tolerate a single leading "---" document-start marker; a full
        // multi-document stream (further "---"/"..." separators) is not
        // supported yet.
        if string.eq(self.lines.at(0).getText(), "---") { self.index = 1; }

        if self.index >= self.lines.len() { return new Document(Node.nullValue()); }

        let root = self.block(self.lines.at(self.index).getIndent())?;
        if self.index != self.lines.len() {
            let t = self.lines.at(self.index);
            fail errorAt(ErrorKind.TrailingContent, t.getLine(), "unexpected content after document");
        }
        return new Document(root);
    }

    fun block(indent: Int) Node!Error {
        if self.index >= self.lines.len() {
            fail errorAt(ErrorKind.UnexpectedEnd, 0, "expected a value");
        }
        let text = self.lines.at(self.index).getText();
        if isDash(text) { return self.sequence(indent)?; }
        if findColon(text) >= 0 { return self.mapping(indent)?; }

        // A single indented line with no ':' and no leading '-' is a bare
        // scalar value (e.g. a whole document that is just `hello`).
        self.index = self.index + 1;
        return scalar(text);
    }

    fun mapping(indent: Int) Node!Error {
        let out = new Mapping();
        while self.index < self.lines.len() {
            let t = self.lines.at(self.index);
            if t.getIndent() < indent { break; }
            if t.getIndent() > indent {
                fail errorAt(ErrorKind.InvalidIndent, t.getLine(), "unexpected indentation");
            }

            let text = t.getText();
            if isDash(text) { break; }

            let colon = findColon(text);
            if colon < 0 {
                fail errorAt(ErrorKind.MissingColon, t.getLine(), "mapping entry needs ':'");
            }

            let key = unquoteKey(string.trim(string.owned(slice(string.view(text), 0, colon))));
            let value = string.trim(string.owned(slice(string.view(text), colon + 1, string.stringLen(text) - colon - 1)));
            self.index = self.index + 1;

            if out.has(key) {
                fail errorAt(ErrorKind.DuplicateKey, t.getLine(), "duplicate mapping key: " + key);
            }

            if string.stringLen(value) > 0 {
                out.put(key, scalar(value));
            } else if self.index < self.lines.len() && self.lines.at(self.index).getIndent() > indent {
                let nested = self.block(self.lines.at(self.index).getIndent())?;
                out.put(key, nested);
            } else {
                out.put(key, Node.nullValue());
            }
        }
        return Node.mapping(out);
    }

    fun sequence(indent: Int) Node!Error {
        let out = new Sequence();
        while self.index < self.lines.len() {
            let t = self.lines.at(self.index);
            let text = t.getText();
            if t.getIndent() != indent || !isDash(text) { break; }

            let value = string.trim(string.owned(slice(string.view(text), 1, string.stringLen(text) - 1)));
            let contentIndent = indent + (string.stringLen(text) - string.stringLen(value));
            self.index = self.index + 1;

            if string.stringLen(value) == 0 {
                if self.index < self.lines.len() && self.lines.at(self.index).getIndent() > indent {
                    let nested = self.block(self.lines.at(self.index).getIndent())?;
                    out.push(nested);
                } else {
                    out.push(Node.nullValue());
                }
            } else if findColon(value) >= 0 {
                // Compact "- key: value" form: the sequence item is itself a
                // mapping whose first entry sits on the dash's own line and
                // whose later entries (if any) are indented to line up under
                // that first key, e.g.:
                //   - x: 1
                //     y: 2
                let map = self.compactMappingItem(contentIndent, value, t.getLine())?;
                out.push(Node.mapping(map));
            } else {
                out.push(scalar(value));
            }
        }
        return Node.sequence(out);
    }

    // Shares its per-entry logic with mapping() by construction (both parse
    // "key: value" / "key:" text at a fixed indent) but is kept as separate,
    // duplicated code rather than a common helper called with `self.foo()?`
    // from inside a loop -- see COMPILER_BUGS.md, bug #2, which zapc v0.4.1
    // hits for shapes disturbingly close to this one.
    fun compactMappingItem(indent: Int, firstEntryText: String, firstEntryLine: Int) Mapping!Error {
        let map = new Mapping();

        let firstColon = findColon(firstEntryText);
        if firstColon < 0 {
            fail errorAt(ErrorKind.MissingColon, firstEntryLine, "mapping entry needs ':'");
        }
        let firstKey = unquoteKey(string.trim(string.owned(slice(string.view(firstEntryText), 0, firstColon))));
        let firstValue = string.trim(string.owned(slice(string.view(firstEntryText), firstColon + 1, string.stringLen(firstEntryText) - firstColon - 1)));

        if string.stringLen(firstValue) > 0 {
            map.put(firstKey, scalar(firstValue));
        } else if self.index < self.lines.len() && self.lines.at(self.index).getIndent() > indent {
            let nested = self.block(self.lines.at(self.index).getIndent())?;
            map.put(firstKey, nested);
        } else {
            map.put(firstKey, Node.nullValue());
        }

        while self.index < self.lines.len() && self.lines.at(self.index).getIndent() == indent {
            let t = self.lines.at(self.index);
            let text = t.getText();
            if isDash(text) { break; }

            let colon = findColon(text);
            if colon < 0 {
                fail errorAt(ErrorKind.MissingColon, t.getLine(), "mapping entry needs ':'");
            }
            let key = unquoteKey(string.trim(string.owned(slice(string.view(text), 0, colon))));
            let value = string.trim(string.owned(slice(string.view(text), colon + 1, string.stringLen(text) - colon - 1)));
            self.index = self.index + 1;

            if map.has(key) {
                fail errorAt(ErrorKind.DuplicateKey, t.getLine(), "duplicate mapping key: " + key);
            }

            if string.stringLen(value) > 0 {
                map.put(key, scalar(value));
            } else if self.index < self.lines.len() && self.lines.at(self.index).getIndent() > indent {
                let nested = self.block(self.lines.at(self.index).getIndent())?;
                map.put(key, nested);
            } else {
                map.put(key, Node.nullValue());
            }
        }

        return map;
    }
}

pub fun parseYaml(input: StringView) Document!Error {
    let parser = new Parser((new Scanner(input)).scan());
    return parser.parse()?;
}

fun isDash(text: String) Bool {
    return (string.stringLen(text) == 1 && string.at(text, 0) == '-')
        || (string.stringLen(text) > 1 && string.at(text, 0) == '-' && string.at(text, 1) == ' ');
}

// First ':' that (a) is not inside a quoted string and (b) is followed by a
// space or end-of-line, per YAML's block-mapping rule -- this is what lets
// unquoted values like `url: http://example.com` parse correctly instead of
// splitting on the colon after "http".
fun findColon(text: String) Int {
    var i: Int = 0;
    var n: Int = string.stringLen(text);
    var inSingle: Bool = false;
    var inDouble: Bool = false;
    while i < n {
        var c: Char = string.at(text, i);
        if inSingle {
            if c == '\'' { inSingle = false; }
        } else if inDouble {
            if c == '\\' { i = i + 1; }
            else if c == '"' { inDouble = false; }
        } else if c == '\'' {
            inSingle = true;
        } else if c == '"' {
            inDouble = true;
        } else if c == ':' && (i + 1 == n || string.at(text, i + 1) == ' ') {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fun stripComment(text: String) String {
    var i: Int = 0;
    var n: Int = string.stringLen(text);
    var inSingle: Bool = false;
    var inDouble: Bool = false;
    while i < n {
        var c: Char = string.at(text, i);
        if inSingle {
            if c == '\'' { inSingle = false; }
        } else if inDouble {
            if c == '\\' { i = i + 1; }
            else if c == '"' { inDouble = false; }
        } else if c == '\'' {
            inSingle = true;
        } else if c == '"' {
            inDouble = true;
        } else if c == '#' && (i == 0 || isSpaceChar(string.at(text, i - 1))) {
            return string.owned(slice(string.view(text), 0, i));
        }
        i = i + 1;
    }
    return text;
}

fun unquoteKey(text: String) String {
    var n: Int = string.stringLen(text);
    if n >= 2 && string.at(text, 0) == '"' && string.at(text, n - 1) == '"' {
        return unescapeDouble(string.owned(slice(string.view(text), 1, n - 2)));
    }
    if n >= 2 && string.at(text, 0) == '\'' && string.at(text, n - 1) == '\'' {
        return unescapeSingle(string.owned(slice(string.view(text), 1, n - 2)));
    }
    return text;
}

fun unescapeSingle(inner: String) String {
    let out = new string.TextBuf();
    var i: Int = 0;
    var n: Int = string.stringLen(inner);
    while i < n {
        var c: Char = string.at(inner, i);
        if c == '\'' && i + 1 < n && string.at(inner, i + 1) == '\'' {
            out.pushChar('\'');
            i = i + 2;
        } else {
            out.pushChar(c);
            i = i + 1;
        }
    }
    return out.build();
}

fun unescapeDouble(inner: String) String {
    let out = new string.TextBuf();
    var i: Int = 0;
    var n: Int = string.stringLen(inner);
    while i < n {
        var c: Char = string.at(inner, i);
        if c == '\\' && i + 1 < n {
            var e: Char = string.at(inner, i + 1);
            if e == 'n' { out.pushChar('\n'); }
            else if e == 't' { out.pushChar('\t'); }
            else if e == 'r' { out.pushChar('\r'); }
            else if e == '0' { out.pushChar(convert.toChar(0)); }
            else if e == '"' { out.pushChar('"'); }
            else if e == '\\' { out.pushChar('\\'); }
            else { out.pushChar(e); }
            i = i + 2;
        } else {
            out.pushChar(c);
            i = i + 1;
        }
    }
    return out.build();
}

fun scalar(text: String) Node {
    if string.stringLen(text) == 0 { return Node.nullValue(); }
    if string.eq(text, "null") || string.eq(text, "~") || string.eq(text, "Null") || string.eq(text, "NULL") {
        return Node.nullValue();
    }
    if string.eq(text, "true") || string.eq(text, "True") || string.eq(text, "TRUE") { return Node.boolean(true); }
    if string.eq(text, "false") || string.eq(text, "False") || string.eq(text, "FALSE") { return Node.boolean(false); }

    var n: Int = string.stringLen(text);
    if n >= 2 && string.at(text, 0) == '\'' && string.at(text, n - 1) == '\'' {
        return Node.string(unescapeSingle(string.owned(slice(string.view(text), 1, n - 2))), ScalarStyle.SingleQuoted);
    }
    if n >= 2 && string.at(text, 0) == '"' && string.at(text, n - 1) == '"' {
        return Node.string(unescapeDouble(string.owned(slice(string.view(text), 1, n - 2))), ScalarStyle.DoubleQuoted);
    }

    if isIntegerText(text) { return Node.integerText(text); }
    if isFloatText(text) { return Node.floatText(text); }

    return Node.string(text, ScalarStyle.Plain);
}
